{
  "name": "schema-memory-monorepo",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "ui": "node packages/cli/dist/index.js ui",
    "start": "node packages/cli/dist/index.js ui",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node packages/server/dist/index.js",
    "dev:web": "pnpm --filter @schema-memory/web dev",
    "status": "node packages/cli/dist/index.js status",
    "setup": "node packages/cli/dist/index.js setup",
    "doctor": "node packages/cli/dist/index.js doctor",
    "link-cli": "node packages/cli/dist/index.js setup --cli-only",
    "sm": "node packages/cli/dist/index.js",
    "bundle:cli": "pnpm --filter @schema-memory/web build && pnpm --filter schema-memory build",
    "pack:cli": "pnpm bundle:cli && pnpm --dir packages/cli pack",
    "build:binary": "pnpm bundle:cli && bun build ./packages/cli/dist/index.js --compile --outfile sm",
    "build:binaries": "pnpm bundle:cli && node scripts/build-binaries.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaixsG/schema-memory.git"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "tsup": "^8.3.6"
  }
}
